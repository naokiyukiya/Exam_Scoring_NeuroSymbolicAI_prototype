{
  "version": "2.4.0_sympy_complete",
  "domain": "physics_mechanics",
  "description": "高校物理・力学分野の完全構造化思考モデルライブラリ（SymPyパース対応・成立条件網羅版）",
  "theorems": [
    {
      "id": "meta_focus_object_forces",
      "name": "注目物体とはたらく力の抽出",
      "type": "meta_focus",
      "inputs": {
        "target_object": "m"
      },
      "outputs": {
        "acting_forces": ["m * g", "N", "T", "F_k", "F_b"]
      }
    },
    {
      "id": "meta_focus_coordinate_system",
      "name": "座標軸・正の向きの設定",
      "type": "meta_focus",
      "inputs": {
        "origin_definition": "x_0",
        "axis_direction": "positive_direction"
      },
      "outputs": {
        "variables": ["x", "delta_x", "v", "a"]
      }
    },
    {
      "id": "meta_keyword_quasistatic_motion",
      "name": "「ゆっくり動かす」条件からの力のつりあい同定（準静的過程）",
      "type": "meta_focus",
      "inputs": {
        "keyword": "slowly_moved"
      },
      "outputs": {
        "acceleration_condition": "a == 0",
        "applied_state": "force_equilibrium"
      }
    },
    {
      "id": "geometry_volume_calculation",
      "name": "体積の計算（直方体・柱体）",
      "type": "math",
      "inputs": {
        "cross_section": "S",
        "height_or_length": "h"
      },
      "outputs": {
        "volume": "V = S * h"
      }
    },
    {
      "id": "law_mass_from_density",
      "name": "密度の定義（体積と密度からの質量計算）",
      "type": "law",
      "inputs": {
        "density": "rho",
        "volume": "V"
      },
      "outputs": {
        "mass": "m = rho * V"
      }
    },
    {
      "id": "kinematics_coordinate_displacement",
      "name": "座標軸に基づく変位・位置関係式",
      "type": "formula",
      "inputs": {
        "reference_position": "x_0",
        "current_position": "x"
      },
      "outputs": {
        "displacement": "delta_x = x - x_0"
      }
    },
    {
      "id": "kinematics_calculus_relations",
      "name": "位置・速度・加速度の微分・積分関係式",
      "type": "formula",
      "inputs": {
        "position_function": "x"
      },
      "outputs": {
        "velocity": "v = diff(x, t)",
        "acceleration": "a = diff(v, t)"
      }
    },
    {
      "id": "kinematics_uniform_accelerated_motion",
      "name": "等加速度直線運動の公式",
      "type": "formula",
      "inputs": {
        "initial_velocity": "v_0",
        "acceleration": "a",
        "time": "t"
      },
      "outputs": {
        "velocity_equation": "v = v_0 + a * t",
        "displacement_equation": "x = v_0 * t + (1/2) * a * t**2",
        "timeless_equation": "v**2 - v_0**2 = 2 * a * x"
      }
    },
    {
      "id": "kinematics_relative_velocity",
      "name": "相対速度",
      "type": "formula",
      "inputs": {
        "object_velocity": "v_A",
        "observer_velocity": "v_B"
      },
      "outputs": {
        "relative_velocity": "v_AB = v_A - v_B"
      }
    },
    {
      "id": "law_gravity_force",
      "name": "重力",
      "type": "law",
      "inputs": {
        "mass": "m",
        "gravity_acc": "g"
      },
      "outputs": {
        "gravity_force": "W = m * g"
      }
    },
    {
      "id": "law_buoyancy_archimedes",
      "name": "アルキメデスの原理（浮力）",
      "type": "law",
      "inputs": {
        "fluid_density": "rho",
        "submerged_volume": "V",
        "gravity_acc": "g"
      },
      "outputs": {
        "buoyant_force": "F_b = rho * V * g"
      }
    },
    {
      "id": "law_hooke",
      "name": "フックの法則（弾性力）",
      "type": "law",
      "inputs": {
        "spring_constant": "k",
        "displacement_from_natural_length": "x"
      },
      "outputs": {
        "elastic_force": "F_k = k * x"
      }
    },
    {
      "id": "law_resultant_force_calculation",
      "name": "合力の計算",
      "type": "formula",
      "inputs": {
        "forces_list": ["F_1", "F_2"]
      },
      "outputs": {
        "net_force": "F_net = F_1 + F_2"
      }
    },
    {
      "id": "principle_force_equilibrium",
      "name": "力のつりあい条件（質点）",
      "type": "principle",
      "inputs": {
        "condition": "a == 0",
        "forces_sum": "F_net"
      },
      "outputs": {
        "equation": "F_net == 0"
      }
    },
    {
      "id": "principle_equation_of_motion",
      "name": "運動方程式",
      "type": "principle",
      "inputs": {
        "mass": "m",
        "acceleration": "a",
        "resultant_force": "F_net"
      },
      "outputs": {
        "equation": "m * a == F_net"
      }
    },
    {
      "id": "def_kinetic_energy",
      "name": "運動エネルギーの定義",
      "type": "law",
      "inputs": {
        "mass": "m",
        "velocity": "v"
      },
      "outputs": {
        "kinetic_energy": "K = (1/2) * m * v**2"
      }
    },
    {
      "id": "def_gravitational_potential_energy",
      "name": "重力による位置エネルギーの定義",
      "type": "law",
      "inputs": {
        "mass": "m",
        "gravity_acc": "g",
        "height_from_reference": "h"
      },
      "outputs": {
        "potential_energy": "U_g = m * g * h"
      }
    },
    {
      "id": "def_elastic_potential_energy",
      "name": "ばねの弾性力による位置エネルギーの定義",
      "type": "law",
      "inputs": {
        "spring_constant": "k",
        "displacement_from_natural_length": "x"
      },
      "outputs": {
        "potential_energy": "U_k = (1/2) * k * x**2"
      }
    },
    {
      "id": "def_work",
      "name": "仕事の定義",
      "type": "law",
      "inputs": {
        "force": "F",
        "displacement": "s",
        "angle": "theta"
      },
      "outputs": {
        "work": "W = F * s * cos(theta)"
      }
    },
    {
      "id": "principle_work_energy_theorem",
      "name": "運動エネルギーと仕事の定理",
      "type": "principle",
      "inputs": {
        "initial_state": "K_1 = (1/2) * m * v_1**2",
        "final_state": "K_2 = (1/2) * m * v_2**2",
        "work_done": "W_total"
      },
      "outputs": {
        "equation": "K_2 - K_1 == W_total"
      }
    },
    {
      "id": "law_mechanical_energy_conservation_spring_natural",
      "name": "力学的エネルギー保存法則（自然長基準＋重力）",
      "type": "law",
      "inputs": {
        "condition": "W_non_cons == 0",
        "state_1": { "v": "v_1", "x": "x_1", "h": "h_1" },
        "state_2": { "v": "v_2", "x": "x_2", "h": "h_2" }
      },
      "outputs": {
        "equation": "(1/2)*m*v_1**2 + m*g*h_1 + (1/2)*k*x_1**2 == (1/2)*m*v_2**2 + m*g*h_2 + (1/2)*k*x_2**2"
      }
    },
    {
      "id": "law_mechanical_energy_conservation_shm_equilibrium",
      "name": "単振動のエネルギー保存法則（つりあい位置基準）",
      "type": "law",
      "inputs": {
        "condition": "W_external == 0",
        "vibration_center": "x_c = 0",
        "restoring_constant": "K",
        "state_1": { "v": "v_1", "x": "x_1" },
        "state_2": { "v": "v_2", "x": "x_2" }
      },
      "outputs": {
        "potential_energy_shm": "U_shm = (1/2) * K * x**2",
        "equation": "(1/2)*m*v_1**2 + (1/2)*K*x_1**2 == (1/2)*m*v_2**2 + (1/2)*K*x_2**2"
      }
    },
    {
      "id": "pattern_restoring_force_direct",
      "name": "合力からの復元力定数の特定（単振動同定）",
      "type": "pattern",
      "inputs": {
        "net_force_equation": "F_net == -K * x"
      },
      "outputs": {
        "motion_type": "simple_harmonic_motion",
        "restoring_constant": "K"
      }
    },
    {
      "id": "pattern_restoring_force",
      "name": "復元力の検出（運動方程式による同定）",
      "type": "pattern",
      "inputs": {
        "equation_form": "m * a == -K * (x - x_c)"
      },
      "outputs": {
        "motion_type": "simple_harmonic_motion",
        "angular_frequency": "omega = sqrt(K / m)",
        "vibration_center": "x_c"
      }
    },
    {
      "id": "formula_simple_harmonic_period",
      "name": "単振動の周期の公式",
      "type": "formula",
      "inputs": {
        "mass": "m",
        "restoring_constant": "K"
      },
      "outputs": {
        "period": "T = 2 * pi * sqrt(m / K)"
      }
    },
    {
      "id": "formula_simple_harmonic_kinematics",
      "name": "単振動の変位・速度・加速度の式",
      "type": "formula",
      "inputs": {
        "amplitude": "A",
        "angular_frequency": "omega",
        "time": "t",
        "initial_phase": "phi"
      },
      "outputs": {
        "displacement": "x = A * sin(omega * t + phi)",
        "velocity": "v = A * omega * cos(omega * t + phi)",
        "max_velocity": "v_max = A * omega",
        "max_acceleration": "a_max = A * omega**2"
      }
    },
    {
      "id": "law_momentum_conservation",
      "name": "運動量保存法則",
      "type": "law",
      "inputs": {
        "condition": "F_ext_sum == 0",
        "objects": { "m_A": "m_A", "m_B": "m_B" },
        "states": { "v_A": "v_A", "v_B": "v_B", "v_A_prime": "v_A_prime", "v_B_prime": "v_B_prime" }
      },
      "outputs": {
        "equation": "m_A * v_A + m_B * v_B == m_A * v_A_prime + m_B * v_B_prime"
      }
    },
    {
      "id": "algebraic_simplification",
      "name": "代数計算・連立方程式の消去",
      "type": "math",
      "inputs": {
        "source_equations": "equations"
      },
      "outputs": {
        "derived_equation": "result"
      }
    }
  ]
}