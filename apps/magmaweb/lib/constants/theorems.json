{
  "version": "3.0_mathjson_ultimate",
  "rule_groups": [
    {
      "group_id": "basic_algebra",
      "name": "文字式と四則計算の基本（中1）",
      "rules": [
        {
          "id": "rule_substitution_basic",
          "name": "代入",
          "level": ["middle", "high"],
          "before": ["Evaluate", ["f", "x"], ["Equal", "x", "a"]],
          "after": ["f", "a"],
          "symbols": { "f": "関数や式", "x": "変数", "a": "代入する定数または式" }
        },
        {
          "id": "rule_add_commutative",
          "name": "加法の交換法則",
          "level": ["middle", "high"],
          "before": ["Add", "a", "b"],
          "after": ["Add", "b", "a"],
          "symbols": { "a": "式A", "b": "式B" }
        },
        {
          "id": "rule_mul_commutative",
          "name": "乗法の交換法則",
          "level": ["middle", "high"],
          "before": ["Multiply", "a", "b"],
          "after": ["Multiply", "b", "a"],
          "symbols": { "a": "式A", "b": "式B" }
        },
        {
          "id": "rule_add_associative",
          "name": "加法の結合法則",
          "level": ["middle", "high"],
          "before": ["Add", ["Add", "a", "b"], "c"],
          "after": ["Add", "a", ["Add", "b", "c"]],
          "symbols": { "a": "式A", "b": "式B", "c": "式C" }
        },
        {
          "id": "rule_mul_associative",
          "name": "乗法の結合法則",
          "level": ["middle", "high"],
          "before": ["Multiply", ["Multiply", "a", "b"], "c"],
          "after": ["Multiply", "a", ["Multiply", "b", "c"]],
          "symbols": { "a": "式A", "b": "式B", "c": "式C" }
        },
        {
          "id": "rule_distributive_expand",
          "name": "分配法則（展開）",
          "level": ["middle", "high"],
          "before": ["Multiply", "a", ["Add", "b", "c"]],
          "after": ["Add", ["Multiply", "a", "b"], ["Multiply", "a", "c"]],
          "symbols": { "a": "式A", "b": "式B", "c": "式C" }
        },
        {
          "id": "rule_distributive_factor",
          "name": "分配法則（くくり出し）",
          "level": ["middle", "high"],
          "before": ["Add", ["Multiply", "a", "b"], ["Multiply", "a", "c"]],
          "after": ["Multiply", "a", ["Add", "b", "c"]],
          "symbols": { "a": "共通因数", "b": "式B", "c": "式C" }
        }
      ]
    },
    {
      "group_id": "fraction_rules",
      "name": "分数の変形規則（中1〜）",
      "rules": [
        {
          "id": "rule_fraction_reduce",
          "name": "約分",
          "level": ["middle", "high"],
          "before": ["Divide", ["Multiply", "a", "c"], ["Multiply", "b", "c"]],
          "after": ["Divide", "a", "b"],
          "conditions":[
            ["NotEqual", "c", 0],
            ["NotEqual", "b", 0]
          ],
          "symbols": { "a": "分子の因数", "b": "分母の因数", "c": "共通因数" }
        },
        {
          "id": "rule_fraction_expand",
          "name": "通分のための分母分子同倍",
          "level": ["middle", "high"],
          "before": ["Divide", "a", "b"],
          "after": ["Divide", ["Multiply", "a", "c"], ["Multiply", "b", "c"]],
          "conditions":[
             ["NotEqual", "b", 0],
             ["NotEqual", "c", 0]
          ],
          "symbols": { "a": "分子", "b": "分母", "c": "掛ける式" }
        },
        {
          "id": "rule_fraction_add_same_denominator",
          "name": "同分母分数の加法",
          "level": ["middle", "high"],
          "before": ["Add", ["Divide", "a", "c"], ["Divide", "b", "c"]],
          "after": ["Divide", ["Add", "a", "b"], "c"],
          "conditions": ["NotEqual", "c", 0],
          "symbols": { "a": "分子1", "b": "分子2", "c": "共通分母" }
        },
        {
          "id": "rule_fraction_add_common_denominator",
          "name": "異分母分数の加法",
          "level": ["middle", "high"],
          "before": ["Add", ["Divide", "a", "b"], ["Divide", "c", "d"]],
          "after": ["Divide", ["Add", ["Multiply", "a", "d"], ["Multiply", "b", "c"]], ["Multiply", "b", "d"]],
          "conditions": [
            ["NotEqual", "b", 0],
            ["NotEqual", "d", 0]
          ],
          "symbols": { "a": "分子1", "b": "分母1", "c": "分子2", "d": "分母2" }
        },
        {
          "id": "rule_fraction_multiply",
          "name": "分数の乗法",
          "level": ["middle", "high"],
          "before": ["Multiply", ["Divide", "a", "b"], ["Divide", "c", "d"]],
          "after": ["Divide", ["Multiply", "a", "c"], ["Multiply", "b", "d"]],
          "conditions": [
            ["NotEqual", "b", 0],
            ["NotEqual", "d", 0]
          ],
          "symbols": { "a": "分子1", "b": "分母1", "c": "分子2", "d": "分母2" }
        },
        {
          "id": "rule_fraction_division",
          "name": "分数の除法",
          "level": ["middle", "high"],
          "before": ["Divide", ["Divide", "a", "b"], ["Divide", "c", "d"]],
          "after": ["Multiply", ["Divide", "a", "b"], ["Divide", "d", "c"]],
          "conditions": [
            ["NotEqual", "b", 0],
            ["NotEqual", "c", 0],
            ["NotEqual", "d", 0]
          ],
          "symbols": { "a": "分子1", "b": "分母1", "c": "分子2", "d": "分母2" }
        }
      ]
    },
    {
      "group_id": "domain_and_definition",
      "name": "式の定義と定義域（中1〜）",
      "rules": [
        {
          "id": "rule_fraction_denominator_not_zero",
          "name": "分母は0にならない（分数の定義）",
          "level": ["middle", "high"],
          "before": ["Divide", "a", "b"],
          "after": ["NotEqual", "b", 0],
          "symbols": { "a": "分子の式や値", "b": "分母の式や値" }
        }
      ]
    },
    {
      "group_id": "power_basic",
      "name": "指数法則（中1〜高2）",
      "rules": [
        {
          "id": "rule_power_product",
          "name": "累乗の積",
          "level": ["middle", "high"],
          "before": ["Multiply", ["Power", "a", "m"], ["Power", "a", "n"]],
          "after": ["Power", "a", ["Add", "m", "n"]],
          "symbols": { "a": "底", "m": "指数1", "n": "指数2" }
        },
        {
          "id": "rule_power_quotient",
          "name": "累乗の商",
          "level": ["middle", "high"],
          "before": ["Divide", ["Power", "a", "m"], ["Power", "a", "n"]],
          "after": ["Power", "a", ["Subtract", "m", "n"]],
          "symbols": { "a": "底", "m": "被除数の指数", "n": "除数の指数" }
        },
        {
          "id": "rule_power_of_power",
          "name": "累乗の累乗",
          "level": ["middle", "high"],
          "before": ["Power", ["Power", "a", "m"], "n"],
          "after": ["Power", "a", ["Multiply", "m", "n"]],
          "symbols": { "a": "底", "m": "内側の指数", "n": "外側の指数" }
        },
        {
          "id": "rule_power_distributive",
          "name": "積の累乗",
          "level": ["middle", "high"],
          "before": ["Power", ["Multiply", "a", "b"], "n"],
          "after": ["Multiply", ["Power", "a", "n"], ["Power", "b", "n"]],
          "symbols": { "a": "因数1", "b": "因数2", "n": "指数" }
        },
        {
          "id": "rule_power_negative",
          "name": "負の指数",
          "level": ["high"],
          "before": ["Power", "a", ["Negate", "n"]],
          "after": ["Divide", 1, ["Power", "a", "n"]],
          "symbols": { "a": "底", "n": "正の指数" }
        },
        {
          "id": "rule_power_fraction",
          "name": "有理数の指数",
          "level": ["high"],
          "before": ["Power", "a", ["Divide", "m", "n"]],
          "after": ["Root", ["Power", "a", "m"], "n"],
          "symbols": { "a": "底", "m": "分子", "n": "分母" }
        }
      ]
    },
    {
      "group_id": "equation_rules",
      "name": "等式変形・一次方程式（中1・中2）",
      "rules": [
        {
          "id": "rule_add_both_sides",
          "name": "両辺に同じ式を加える",
          "level": ["middle", "high"],
          "before": ["Equal", "A", "B"],
          "after": ["Equal", ["Add", "A", "C"], ["Add", "B", "C"]],
          "symbols": { "A": "左辺", "B": "右辺", "C": "加える式" }
        },
        {
          "id": "rule_subtract_both_sides",
          "name": "両辺から同じ式を引く",
          "level": ["middle", "high"],
          "before": ["Equal", "A", "B"],
          "after": ["Equal", ["Subtract", "A", "C"], ["Subtract", "B", "C"]],
          "symbols": { "A": "左辺", "B": "右辺", "C": "引く式" }
        },
        {
          "id": "rule_multiply_both_sides",
          "name": "両辺に同じ式を掛ける",
          "level": ["middle", "high"],
          "before": ["Equal", "A", "B"],
          "after": ["Equal", ["Multiply", "A", "C"], ["Multiply", "B", "C"]],
          "symbols": { "A": "左辺", "B": "右辺", "C": "掛ける式" }
        },
        {
          "id": "rule_divide_both_sides",
          "name": "両辺を同じ式で割る",
          "level": ["middle", "high"],
          "before": ["Equal", "A", "B"],
          "after": ["Equal", ["Divide", "A", "C"], ["Divide", "B", "C"]],
          "conditions": ["NotEqual", "C", 0],
          "symbols": { "A": "左辺", "B": "右辺", "C": "割る式" }
        },
        {
          "id": "rule_transposition_add",
          "name": "移項（加法）",
          "level": ["middle", "high"],
          "before": ["Equal", ["Add", "A", "C"], "B"],
          "after": ["Equal", "A", ["Subtract", "B", "C"]],
          "symbols": { "A": "左辺に残す式", "C": "移項する項", "B": "右辺" }
        },
        {
          "id": "rule_transposition_subtract",
          "name": "移項（減法）",
          "level": ["middle", "high"],
          "before": ["Equal", ["Subtract", "A", "C"], "B"],
          "after": ["Equal", "A", ["Add", "B", "C"]],
          "symbols": { "A": "左辺に残す式", "C": "移項する項", "B": "右辺" }
        },
        {
          "id": "rule_clear_denominator",
          "name": "分母を払う",
          "level": ["middle", "high"],
          "before": ["Equal", ["Divide", "A", "b"], ["Divide", "C", "d"]],
          "after": ["Equal", ["Multiply", "d", "A"], ["Multiply", "b", "C"]],
          "symbols": { "A": "分子1", "b": "分母1", "C": "分子2", "d": "分母2" }
        },
        {
          "id": "rule_clear_denominator_single",
          "name": "分母を払う（片辺のみ）",
          "level": ["middle", "high"],
          "before": ["Equal", ["Divide", "A", "b"], "C"],
          "after": ["Equal", "A", ["Multiply", "b", "C"]],
          "symbols": { "A": "左辺の分子", "b": "左辺の分母", "C": "右辺の式" }
        }
      ]
    },
    {
      "group_id": "inequality_rules",
      "name": "不等式の変形（中1・高1）",
      "rules": [
        {
          "id": "rule_inequality_add_both_sides",
          "name": "不等式の両辺に加える",
          "level": ["middle", "high"],
          "before": ["Less", "A", "B"],
          "after": ["Less", ["Add", "A", "C"], ["Add", "B", "C"]],
          "symbols": { "A": "左辺", "B": "右辺", "C": "加える式" }
        },
        {
          "id": "rule_inequality_multiply_positive",
          "name": "両辺に正の数を掛ける",
          "level": ["middle", "high"],
          "before": ["Less", "A", "B"],
          "after": ["Less", ["Multiply", "A", "C"], ["Multiply", "B", "C"]],
          "conditions": ["Greater", "C", 0],
          "symbols": { "A": "左辺", "B": "右辺", "C": "正の数" }
        },
        {
          "id": "rule_inequality_multiply_negative",
          "name": "両辺に負の数を掛ける（反転）",
          "level": ["middle", "high"],
          "before": ["Less", "A", "B"],
          "after": ["Greater", ["Multiply", "A", "C"], ["Multiply", "B", "C"]],
          "conditions": ["Less", "C", 0],
          "symbols": { "A": "左辺", "B": "右辺", "C": "負の数" }
        }
      ]
    },
    {
      "group_id": "inequality_and_range_mathjson",
      "name": "不等式と範囲・等号成立条件（高1〜高2）",
      "rules": [
        {
          "id": "rule_combine_multiple_conditions",
          "name": "複数の条件を組み合わせる",
          "level": ["middle", "high"],
          "before": [
            "And",
            ["List", "conditions"]
          ],
          "after": [
            "Interval",
            ["Max", ["Map", "GetLowerBound", "conditions"]],
            ["Min", ["Map", "GetUpperBound", "conditions"]]
          ],
          "symbols": { "conditions": "不等式条件のリスト", "GetLowerBound": "下限取得関数", "GetUpperBound": "上限取得関数" }
        },
        {
          "id": "rule_equality_condition_general",
          "name": "等号が成立する変数を求める（一般）",
          "level": ["middle", "high"],
          "before": ["GreaterEqual", "A", "B"],
          "after": ["Equal", "A", "B"],
          "symbols": { "A": "大きい側", "B": "小さい側" }
        },
        {
          "id": "rule_equality_condition_am_gm",
          "name": "等号が成立する変数を求める（相加・相乗平均）",
          "level": ["high"],
          "before": [
            "GreaterEqual",
            ["Divide", ["Add", "a", "b"], 2],
            ["Sqrt", ["Multiply", "a", "b"]]
          ],
          "after": ["Equal", "a", "b"],
          "symbols": { "a": "正の変数", "b": "正の変数" }
        }
      ]
    },
    {
      "group_id": "expansion_factorization_basic",
      "name": "展開・因数分解の基礎（中3）",
      "rules": [
        {
          "id": "rule_expand_square_sum",
          "name": "平方の展開",
          "level": ["middle", "high"],
          "before": ["Power", ["Add", "a", "b"], 2],
          "after": ["Add", ["Power", "a", 2], ["Multiply", 2, "a", "b"], ["Power", "b", 2]],
          "symbols": { "a": "項1", "b": "項2" }
        },
        {
          "id": "rule_expand_square_difference",
          "name": "差の平方の展開",
          "level": ["middle", "high"],
          "before": ["Power", ["Subtract", "a", "b"], 2],
          "after": ["Add", ["Power", "a", 2], ["Negate", ["Multiply", 2, "a", "b"]], ["Power", "b", 2]],
          "symbols": { "a": "項1", "b": "項2" }
        },
        {
          "id": "rule_expand_sum_difference",
          "name": "和と差の積の展開",
          "level": ["middle", "high"],
          "before": ["Multiply", ["Add", "a", "b"], ["Subtract", "a", "b"]],
          "after": ["Subtract", ["Power", "a", 2], ["Power", "b", 2]],
          "symbols": { "a": "項1", "b": "項2" }
        },
        {
          "id": "rule_factor_difference_of_squares",
          "name": "平方差の因数分解",
          "level": ["middle", "high"],
          "before": ["Subtract", ["Power", "a", 2], ["Power", "b", 2]],
          "after": ["Multiply", ["Add", "a", "b"], ["Subtract", "a", "b"]],
          "symbols": { "a": "項1", "b": "項2" }
        }
      ]
    },
    {
      "group_id": "square_root_rules",
      "name": "平方根・絶対値（中3〜高1）",
      "rules": [
        {
          "id": "rule_root_square",
          "name": "平方根と2乗",
          "level": ["middle", "high"],
          "before": ["Sqrt", ["Power", "a", 2]],
          "after": ["AbsoluteValue", "a"],
          "symbols": { "a": "実数" }
        },
        {
          "id": "rule_root_product",
          "name": "平方根の積",
          "level": ["middle", "high"],
          "before": ["Multiply", ["Sqrt", "a"], ["Sqrt", "b"]],
          "after": ["Sqrt", ["Multiply", "a", "b"]],
          "symbols": { "a": "正の数", "b": "正の数" }
        },
        {
          "id": "rule_rationalize_denominator",
          "name": "分母の有理化（単項）",
          "level": ["middle", "high"],
          "before": ["Divide", "a", ["Sqrt", "b"]],
          "after": ["Divide", ["Multiply", "a", ["Sqrt", "b"]], "b"],
          "symbols": { "a": "分子", "b": "分母の根号内" }
        },
        {
          "id": "rule_rationalize_conjugate",
          "name": "分母の有理化（和と差の積）",
          "level": ["high"],
          "before": ["Divide", "c", ["Add", ["Sqrt", "a"], ["Sqrt", "b"]]],
          "after": ["Divide", ["Multiply", "c", ["Subtract", ["Sqrt", "a"], ["Sqrt", "b"]]], ["Subtract", "a", "b"]],
          "symbols": { "c": "分子", "a": "分母の項1", "b": "分母の項2" }
        },
        {
          "id": "rule_absolute_inequality_less",
          "name": "絶対値を含む不等式（小なり）",
          "level": ["high"],
          "before": ["Less", ["AbsoluteValue", "x"], "a"],
          "after": ["And", ["Less", ["Negate", "a"], "x"], ["Less", "x", "a"]],
          "symbols": { "x": "式", "a": "正の定数" }
        },
        {
          "id": "rule_absolute_inequality_greater",
          "name": "絶対値を含む不等式（大なり）",
          "level": ["high"],
          "before": ["Greater", ["AbsoluteValue", "x"], "a"],
          "after": ["Or", ["Less", "x", ["Negate", "a"]], ["Greater", "x", "a"]],
          "symbols": { "x": "式", "a": "正の定数" }
        }
      ]
    },
    {
      "group_id": "quadratic_equations_basic",
      "name": "二次方程式の基礎（中3）",
      "rules": [
        {
          "id": "rule_zero_product_property",
          "name": "積が0なら少なくとも一方が0",
          "level": ["middle", "high"],
          "before": ["Equal", ["Multiply", "A", "B"], 0],
          "after": ["Or", ["Equal", "A", 0], ["Equal", "B", 0]],
          "symbols": { "A": "因数1", "B": "因数2" }
        },
        {
          "id": "rule_quadratic_formula",
          "name": "解の公式の適用",
          "level": ["middle", "high"],
          "before": ["Equal", ["Add", ["Multiply", "a", ["Power", "x", 2]], ["Multiply", "b", "x"], "c"], 0],
          "after": [
            "Equal",
            "x",
            ["Divide",
              ["PlusMinus", ["Negate", "b"], ["Sqrt", ["Subtract", ["Power", "b", 2], ["Multiply", 4, "a", "c"]]]],
              ["Multiply", 2, "a"]
            ]
          ],
          "symbols": { "x": "変数", "a": "x^2の係数", "b": "xの係数", "c": "定数" }
        }
      ]
    },
    {
      "group_id": "expansion_factorization_advanced",
      "name": "3次式の展開因数分解（高1）",
      "rules": [
        {
          "id": "rule_absolute_value_def",
          "name": "絶対値の定義",
          "level": ["high"],
          "before": ["AbsoluteValue", "a"],
          "after": ["Piecewise", ["a", ["GreaterEqual", "a", 0]], [["Negate", "a"], ["Less", "a", 0]]],
          "symbols": { "a": "式" }
        },
        {
          "id": "rule_expand_cubic_sum",
          "name": "立方の展開",
          "level": ["high"],
          "before": ["Power", ["Add", "a", "b"], 3],
          "after": ["Add", ["Power", "a", 3], ["Multiply", 3, ["Power", "a", 2], "b"], ["Multiply", 3, "a", ["Power", "b", 2]], ["Power", "b", 3]],
          "symbols": { "a": "項1", "b": "項2" }
        },
        {
          "id": "rule_factor_sum_of_cubes",
          "name": "立方和の因数分解",
          "level": ["high"],
          "before": ["Add", ["Power", "a", 3], ["Power", "b", 3]],
          "after": ["Multiply", ["Add", "a", "b"], ["Add", ["Power", "a", 2], ["Negate", ["Multiply", "a", "b"]], ["Power", "b", 2]]],
          "symbols": { "a": "項1", "b": "項2" }
        }
      ]
    },
    {
      "group_id": "quadratic_functions",
      "name": "二次関数（高1）",
      "rules": [
        {
          "id": "rule_complete_square",
          "name": "平方完成",
          "level": ["high"],
          "before": ["Add", ["Multiply", "a", ["Power", "x", 2]], ["Multiply", "b", "x"], "c"],
          "after": [
            "Add",
            ["Multiply", "a", ["Power", ["Add", "x", ["Divide", "b", ["Multiply", 2, "a"]]], 2]],
            ["Subtract", "c", ["Divide", ["Power", "b", 2], ["Multiply", 4, "a"]]]
          ],
          "symbols": { "x": "変数", "a": "係数", "b": "係数", "c": "定数" }
        },
        {
          "id": "rule_discriminant",
          "name": "判別式 D",
          "level": ["high"],
          "before": ["Discriminant", ["Add", ["Multiply", "a", ["Power", "x", 2]], ["Multiply", "b", "x"], "c"]],
          "after": ["Subtract", ["Power", "b", 2], ["Multiply", 4, "a", "c"]],
          "symbols": { "a": "x^2の係数", "b": "xの係数", "c": "定数項" }
        }
      ]
    },
    {
      "group_id": "trigonometry_basic",
      "name": "三角比（高1）",
      "rules": [
        {
          "id": "rule_trig_pythagorean",
          "name": "相互関係（平方和）",
          "level": ["high"],
          "before": ["Add", ["Power", ["Sin", "x"], 2], ["Power", ["Cos", "x"], 2]],
          "after": 1,
          "symbols": { "x": "角度" }
        },
        {
