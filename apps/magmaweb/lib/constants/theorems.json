          "before": ["Derivative", ["Log", "x"], "x"],
          "after": ["Divide", 1, "x"],
          "symbols": { "x": "変数", "Log": "自然対数" }
        },
        {
          "id": "rule_derivative_product",
          "name": "積の微分法則",
          "level": ["high"],
          "before": ["Derivative", ["Multiply", ["f", "x"], ["g", "x"]], "x"],
          "after": ["Add", ["Multiply", ["Derivative", ["f", "x"], "x"], ["g", "x"]], ["Multiply", ["f", "x"], ["Derivative", ["g", "x"], "x"]]],
          "symbols": { "f": "関数", "g": "関数", "x": "変数" }
        },
        {
          "id": "rule_derivative_quotient",
          "name": "商の微分法則",
          "level": ["high"],
          "before": ["Derivative", ["Divide", ["f", "x"], ["g", "x"]], "x"],
          "after": ["Divide", ["Subtract", ["Multiply", ["Derivative", ["f", "x"], "x"], ["g", "x"]], ["Multiply", ["f", "x"], ["Derivative", ["g", "x"], "x"]]], ["Power", ["g", "x"], 2]],
          "symbols": { "f": "分子の関数", "g": "分母の関数", "x": "変数" }
        },
        {
          "id": "rule_derivative_chain",
          "name": "合成関数の微分",
          "level": ["high"],
          "before": ["Derivative", ["f", ["g", "x"]], "x"],
          "after": ["Multiply", ["Evaluate", ["Derivative", ["f", "u"], "u"], ["Equal", "u", ["g", "x"]]], ["Derivative", ["g", "x"], "x"]],
          "symbols": { "f": "外の関数", "g": "中の関数", "x": "変数", "u": "置換変数" }
        }
      ]
    },
    {
      "group_id": "calculus_integrals",
      "name": "積分法の発展（高3）",
      "rules": [
        {
          "id": "rule_integral_power_real",
          "name": "累乗関数の不定積分",
          "level": ["high"],
          "before": ["Integral", ["Power", "x", "p"], "x"],
          "after": ["Add", ["Divide", ["Power", "x", ["Add", "p", 1]], ["Add", "p", 1]], "C"],
          "conditions": ["NotEqual", "p", -1],
          "symbols": { "x": "変数", "p": "実数", "C": "積分定数" }
        },
        {
          "id": "rule_integral_inverse",
          "name": "1/x の不定積分",
          "level": ["high"],
          "before": ["Integral", ["Divide", 1, "x"], "x"],
          "after": ["Add", ["Log", ["AbsoluteValue", "x"]], "C"],
          "symbols": { "x": "変数", "C": "積分定数", "Log": "自然対数" }
        },
        {
          "id": "rule_integral_sin",
          "name": "sinの積分",
          "level": ["high"],
          "before": ["Integral", ["Sin", "x"], "x"],
          "after": ["Add", ["Negate", ["Cos", "x"]], "C"],
          "symbols": { "x": "変数", "C": "積分定数" }
        },
        {
          "id": "rule_integral_exp",
          "name": "指数関数の積分",
          "level": ["high"],
          "before": ["Integral", ["Power", "e", "x"], "x"],
          "after": ["Add", ["Power", "e", "x"], "C"],
          "symbols": { "x": "変数", "e": "ネイピア数", "C": "積分定数" }
        },
        {
          "id": "rule_integral_substitution",
          "name": "置換積分法",
          "level": ["high"],
          "before": ["Integral", ["Multiply", ["f", ["g", "x"]], ["Derivative", ["g", "x"], "x"]], "x"],
          "after": ["Integral", ["f", "u"], "u"],
          "symbols": { "f": "関数", "g": "置換対象の関数", "x": "元の変数", "u": "新しい変数(g(x))" }
        },
        {
          "id": "rule_integral_by_parts",
          "name": "部分積分法",
          "level": ["high"],
          "before": ["Integral", ["Multiply", ["f", "x"], ["Derivative", ["g", "x"], "x"]], "x"],
          "after": ["Subtract", ["Multiply", ["f", "x"], ["g", "x"]], ["Integral", ["Multiply", ["Derivative", ["f", "x"], "x"], ["g", "x"]], "x"]],
          "symbols": { "f": "関数", "g": "関数", "x": "変数" }
        },
        {
          "id": "rule_fundamental_theorem_calculus",
          "name": "微積分学の基本定理",
          "level": ["high"],
          "before": ["Derivative", ["DefiniteIntegral", ["f", "t"], "t", "a", "x"], "x"],
          "after": ["f", "x"],
          "symbols": { "f": "関数", "t": "積分変数", "a": "定数の下端", "x": "変数である上端" }
        }
      ]
    }
  ]
}